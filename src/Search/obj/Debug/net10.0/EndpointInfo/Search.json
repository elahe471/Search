{
  "openapi": "3.0.4",
  "info": {
    "title": "Search",
    "version": "1.0"
  },
  "paths": {
    "/api/v1/search": {
      "get": {
        "tags": [
          "Search APIs"
        ],
        "parameters": [
          {
            "name": "text",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItemIndex"
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    }
  },
  "components": {
